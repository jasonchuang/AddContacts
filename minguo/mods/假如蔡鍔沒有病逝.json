 "bios": {
  "段祺瑞": {
   "zi": "芝泉",
   "home": "安徽合肥",
   "life": "1865－1936",
   "bio": "北洋武備學堂出身，留學德國學習炮兵，是袁世凱小站練兵的骨幹，與王士珍、馮國璋並稱「北洋三傑」。袁世凱死後以國務總理掌握北京政府，張勳復辟時在馬廠誓師討伐，自稱「再造共和」。推行武力統一並向日本大舉借款，1920 年直皖戰爭失敗下野；1924 年出任臨時執政，1926 年三一八慘案後下台，晚年寓居上海。",
   "tale": "人稱「六不總理」：不貪污、不受賄、不抽菸、不喝酒、不嫖、不賭，平日最愛下圍棋。"
  },
  "徐樹錚": {
   "zi": "又錚",
   "home": "江蘇蕭縣",
   "life": "1880－1925",
   "bio": "日本陸軍士官學校畢業，段祺瑞最倚重的謀士。府院之爭時任國務院秘書長，作風強硬。1919 年以西北籌邊使率軍進入外蒙古，使外蒙古一度撤銷自治。直皖戰爭後遭通緝，1925 年在廊坊車站被馮玉祥部下截殺。",
   "tale": "工詩詞、愛崑曲，又常替段祺瑞出主意，人稱「小扇子」。"
  },
  "段芝貴": {
   "zi": "香巖",
   "home": "安徽合肥",
   "life": "1869－1925",
   "bio": "袁世凱的親信將領。1917 年張勳復辟時任討逆軍東路司令；1920 年直皖戰爭任皖系前線總指揮，在京漢線上被直軍擊敗，從此失勢。"
  },
  "靳雲鵬": {
   "zi": "翼青",
   "home": "山東濟寧",
   "life": "1877－1951",
   "bio": "段祺瑞的門生，皖系要角。1919 至 1921 年間兩度出任國務總理，夾在直、皖、奉三派之間調和，最後被迫辭職，晚年在天津潛心佛學。"
  },
  "王士珍": {
   "zi": "聘卿",
   "home": "直隸正定",
   "life": "1861－1930",
   "bio": "北洋三傑中的「龍」，為人低調、不爭權位。府院之爭後曾短暫出任國務總理，晚年在北京從事地方慈善與維持秩序。"
  },
  "張敬堯": {
   "zi": "勳臣",
   "home": "安徽霍邱",
   "life": "1881－1933",
   "bio": "1918 年任湖南督軍，治湘橫徵暴斂，湖南各界發起「驅張運動」，1920 年被湘軍逐出。1933 年在北平被刺殺。"
  },
  "盧永祥": {
   "zi": "子嘉",
   "home": "山東濟陽",
   "life": "1867－1933",
   "bio": "皖系大將，任浙江督軍，連上海也在其勢力範圍。直皖戰後皖系只剩他還有地盤，1924 年與江蘇的齊燮元爆發江浙戰爭，兵敗下野。"
  },
  "何豐林": {
   "zi": "茂如",
   "home": "山東平陰",
   "life": "1873－1935",
   "bio": "盧永祥的部將，任淞滬護軍使，掌控上海的稅收與兵工廠。江浙戰爭中與盧永祥一同敗退。"
  },
  "吳光新": {
   "zi": "自堂",
   "home": "安徽合肥",
   "life": "1881－1939",
   "bio": "段祺瑞的妻弟，任長江上游總司令，負責對西南用兵。直皖戰爭爆發時正在漢口，被湖北督軍王占元扣押。"
  },
  "倪嗣沖": {
   "zi": "丹忱",
   "home": "安徽阜陽",
   "life": "1868－1924",
   "bio": "長期任安徽督軍，盤踞皖北多年，是皖系重要的地方實力派，支持帝制，也是督軍團的成員。"
